generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum Role {
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
  USER
  AUDITOR
}

enum TechnicalStatus {
  OPERATIONAL
  DAMAGED
  UNDER_MAINTENANCE
  UNDER_REPAIR
  OUT_OF_SERVICE
  DECOMMISSIONED
  IN_TRANSIT
}

enum UsageStatus {
  AVAILABLE
  ASSIGNED
  RESERVED
  UNAVAILABLE
  ON_LOAN
}

enum LocationType {
  CAMPUS
  BUILDING
  FLOOR
  AREA
  OFFICE
  LABORATORY
  WAREHOUSE
  SERVER_ROOM
  WORKSTATION
}

enum EventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  MAINTENANCE
  CATEGORY_CHANGED
  LOCATION_CHANGED
  DECOMMISSIONED
  REACTIVATED
  LOANED
  RETURNED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  CALIBRATION
  UPDATE
  CLEANING
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  REQUEST_APPROVED
  REQUEST_REJECTED
  MAINTENANCE_DUE
  NEW_ASSIGNMENT
  WARRANTY_EXPIRING
  ASSET_DECOMMISSIONED
}

//////////////////////
// USERS
//////////////////////

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  role       Role      @default(USER)
  avatarUrl  String?
  phone      String?
  department String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments          AssetAssignment[]
  assignmentsCreated   AssetAssignment[]  @relation("AssignmentCreatedBy")
  logs                 EventLog[]         @relation("EventLogUser")
  requests             MovementRequest[]  @relation("RequestCreatedBy")
  approvals            MovementRequest[]  @relation("RequestApprovedBy")
  maintenancesHandled  Maintenance[]      @relation("MaintenanceHandledBy")
  notifications        Notification[]
  qrScans              QRScan[]
  labelsGenerated      AssetLabel[]       @relation("LabelGeneratedBy")

  @@index([role])
  @@index([deletedAt])
  @@index([department])
}

//////////////////////
// CATALOGS
//////////////////////

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  iconName    String?
  color       String?

  parentId Int?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
}

model Location {
  id          Int          @id @default(autoincrement())
  name        String
  type        LocationType
  description String?
  // Hierarchical unique code (e.g. "CUC-BQ-BA-P2-LAB-NETS")
  code        String?      @unique

  parentId Int?
  parent   Location?  @relation("LocationParent", fields: [parentId], references: [id])
  children Location[] @relation("LocationParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets           Asset[]
  movementRequests MovementRequest[] @relation("RequestDestination")

  // same name allowed only under different parents
  @@unique([name, parentId])
  @@index([parentId])
  @@index([type])
  @@index([code])
}

//////////////////////
// ASSETS
//////////////////////

model Asset {
  id Int @id @default(autoincrement())

  name             String
  inventoryCode    String  @unique
  // WARNING: store null, never "". Two empty strings break @unique.
  // Validate at application layer before persisting.
  serialNumber     String? @unique
  // Auto-generated with nanoid(10) on asset creation.
  // Encodes the URL: https://[domain]/qr/[qrCode]
  qrCode           String? @unique

  technicalStatus TechnicalStatus @default(OPERATIONAL)
  usageStatus     UsageStatus     @default(AVAILABLE)

  acquisitionDate  DateTime?
  warrantyExpiry   DateTime?
  acquisitionValue Decimal?  @db.Decimal(12, 2)
  currentValue     Decimal?  @db.Decimal(12, 2)

  imageUrl String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  assignments  AssetAssignment[]
  logs         EventLog[]
  requests     MovementRequest[]
  maintenances Maintenance[]
  spec         AssetSpec?
  qrScans      QRScan[]
  labels       AssetLabel[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([technicalStatus])
  @@index([usageStatus])
  @@index([categoryId])
  @@index([locationId])
  @@index([warrantyExpiry])
  @@index([deletedAt])
}

model AssetSpec {
  id      Int @id @default(autoincrement())
  assetId Int @unique

  // hardware
  brand         String?
  model         String?
  cpu           String?
  ram           String?
  storage       String?
  screenSize    String? // inches or resolution (monitors, laptops)

  // software
  operatingSystem   String?
  osVersion         String?
  osLicense         String?

  // network
  ipAddress  String?
  // WARNING: store null, never "". Validate at application layer.
  macAddress String? @unique
  hostname   String?
  vlan       String?

  // unstructured additional specs
  data Json?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([ipAddress])
  @@index([hostname])
}

//////////////////////
// ASSIGNMENTS
//////////////////////

model AssetAssignment {
  id Int @id @default(autoincrement())

  userId      Int
  assetId     Int
  createdById Int?

  startDate    DateTime  @default(now())
  endDate      DateTime?
  reason       String?
  notes        String?

  user      User  @relation(fields: [userId], references: [id])
  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AssignmentCreatedBy", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([userId])
  @@index([createdById])
  @@index([endDate])

  // WARNING: Prisma does NOT support partial indexes natively.
  // Run this SQL manually after the first migration:
  //
  // CREATE UNIQUE INDEX unique_active_assignment
  // ON "AssetAssignment" ("assetId")
  // WHERE "endDate" IS NULL;
  //
  // Ensures one asset can only have ONE active assignment at a time.
  // NULL is not considered duplicate in PostgreSQL.
}

//////////////////////
// AUDIT LOG
//////////////////////

model EventLog {
  id          Int       @id @default(autoincrement())
  type        EventType
  description String
  occurredAt  DateTime  @default(now())

  // Structure: { before: { field: value }, after: { field: value } }
  metadata Json?

  sourceIp   String?
  userAgent  String?

  assetId Int
  userId  Int?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation("EventLogUser", fields: [userId], references: [id])

  @@index([assetId, occurredAt])
  @@index([type])
  @@index([userId])
}

//////////////////////
// MOVEMENT REQUESTS
//////////////////////

model MovementRequest {
  id Int @id @default(autoincrement())

  assetId            Int
  requestedById      Int
  approvedById       Int?
  destinationId      Int?

  reason String

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("RequestCreatedBy", fields: [requestedById], references: [id])
  approvedBy  User?     @relation("RequestApprovedBy", fields: [approvedById], references: [id])
  destination Location? @relation("RequestDestination", fields: [destinationId], references: [id])

  @@index([assetId])
  @@index([requestedById])
  @@index([status])
}

//////////////////////
// MAINTENANCE
//////////////////////

model Maintenance {
  id Int @id @default(autoincrement())

  assetId     Int
  type        MaintenanceType
  status      MaintenanceStatus @default(SCHEDULED)
  description String

  provider  String?
  cost      Decimal? @db.Decimal(12, 2)

  scheduledAt  DateTime
  completedAt  DateTime?

  handledById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  handledBy User? @relation("MaintenanceHandledBy", fields: [handledById], references: [id])

  @@index([assetId])
  @@index([scheduledAt])
  @@index([type])
  @@index([status])
  @@index([handledById])
}

//////////////////////
// NOTIFICATIONS
//////////////////////

model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int
  type    NotificationType
  title   String
  message String
  read    Boolean          @default(false)
  // Internal route on click (e.g. "/assets/42")
  url     String?

  // Generic reference to the object that triggered the notification
  referenceId   Int?
  referenceType String? // "Asset" | "MovementRequest" | "Maintenance"

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

//////////////////////
// QR TRACKING
//////////////////////

model QRScan {
  id        Int      @id @default(autoincrement())
  assetId   Int
  userId    Int?     // null for anonymous scans (public endpoint)
  sourceIp  String?
  userAgent String?
  scannedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@index([scannedAt])
}

//////////////////////
// PRINTABLE LABELS
//////////////////////

model AssetLabel {
  id          Int      @id @default(autoincrement())
  assetId     Int
  // Supported formats: A4, DYMO, ZEBRA
  format      String   @default("A4")
  generatedBy Int?
  createdAt   DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  generator User? @relation("LabelGeneratedBy", fields: [generatedBy], references: [id])

  @@index([assetId])
}

